# Optional. Manual editing and server storage work without a Claude key.
# Copy to .env, fill privately, and launch `npm run dev:env` or `npm run start:env`.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8787
STUDIO_DATA_DIR=studio-data
STUDIO_ENABLE_AI=0
ANTHROPIC_API_KEY=
# Only needed for explicitly configured private network/reverse-proxy access:
# STUDIO_ORIGIN=https://your-private-host.example
# STUDIO_ACCESS_TOKEN=generate-a-long-random-access-code
# Optional. Path to a Blender executable (e.g. /Applications/Blender.app/Contents/MacOS/Blender). Without it render jobs stay queued.
# BLENDER_PATH=
# Optional, local dev only: extra allowed browser origins (loopback), comma separated.
# STUDIO_EXTRA_ORIGINS=http://127.0.0.1:4195
