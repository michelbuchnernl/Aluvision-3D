{
  "name": "boormester-immersive-studio",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "tsc -b",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "format": "prettier --write src server scripts tests e2e vite.config.ts playwright.config.mjs",
    "format:check": "prettier --check src server scripts tests e2e vite.config.ts playwright.config.mjs",
    "dev:env": "node --env-file=.env scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4173",
    "server": "node --experimental-strip-types server/index.ts",
    "start": "node --experimental-strip-types server/index.ts",
    "start:env": "node --env-file=.env --experimental-strip-types server/index.ts",
    "test:e2e": "playwright test",
    "blender:dry": "node --experimental-strip-types scripts/blender-dry-run.mjs",
    "knowledge:check": "node --experimental-strip-types scripts/knowledge-check.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
